# Grav Academy Server Configuration
PORT=5000
NODE_ENV=development

# Online MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/grav_academy?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secrets for Authentication
JWT_SECRET=grav_academy_jwt_super_secure_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Google Drive API Configuration (OAuth 2.0 for admin Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
